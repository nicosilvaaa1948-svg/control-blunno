// Reglas base. Antes de producción, configurar autenticación y permisos por rol.
// Este archivo es intencionalmente conservador y requiere autenticación.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
